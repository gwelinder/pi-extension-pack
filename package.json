{
  "name": "pi-extension-pack",
  "version": "0.1.0",
  "description": "A curated Pi bootstrap package for owned extensions, owned skills, and recovery docs for Gustav's Pi setup.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "memory",
    "codex-ui-design",
    "frontend-stack",
    "exa",
    "web-search",
    "rich-fetch",
    "codegraph",
    "semantic-code-search",
    "github",
    "pdf",
    "youtube",
    "gemini"
  ],
  "scripts": {
    "audit": "node scripts/audit-local.mjs",
    "audit:skills": "node scripts/audit-skill-usage.mjs",
    "audit:agent-skills": "node scripts/audit-agent-skill-topology.mjs",
    "audit:harness-skills": "node scripts/audit-harness-prompt-surfaces.mjs",
    "propose:skill-maintenance": "node scripts/propose-skill-maintenance.mjs",
    "sync:agent-skills": "node scripts/sync-agent-skills.mjs",
    "sync:agent-skills:apply": "node scripts/sync-agent-skills.mjs --apply",
    "test:skill-gateway": "node extras/skill-gateway/test/gateway.test.mjs && node extras/skill-gateway/eval/score-skill-gateway.mjs",
    "test:codex-mode-toggle": "bun test extras/codex-mode-toggle/core.test.ts",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "sync:owned": "node scripts/sync-owned-resources.mjs"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "0.9.7",
    "gpt-tokenizer": "3.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gwelinder/pi-extension-pack.git"
  },
  "homepage": "https://github.com/gwelinder/pi-extension-pack",
  "bugs": {
    "url": "https://github.com/gwelinder/pi-extension-pack/issues"
  },
  "files": [
    "extensions",
    "skills",
    "prompts",
    "themes",
    "extras",
    "docs",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
